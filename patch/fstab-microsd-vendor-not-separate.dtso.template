/dts-v1/;
/plugin/;

/ {
	fragment@0 {
		target-path = "/firmware/android";
		__overlay__ {
			fstab {
				compatible = "android,fstab";

				system {
					compatible = "android,system";
					dev = "[MICROSD_DEVICE_PATH]/by-name/microsd_system";
					status = "ok";
				};

				cache {
					compatible = "android,cache";
					dev = "[EMMC_DEVICE_PATH]/by-name/cache";
					type = "ext4";
					mnt_point = "/internalcachesothatwecanbootfromsdcard";
					mnt_flags = "ro";
					fsmgr_flags = "wait";
					status = "ok";
				};
			};
		};
	};
};
